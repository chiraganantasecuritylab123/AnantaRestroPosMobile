  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "start:reset": "react-native start --reset-cache",
    "start:short": "cd /d D:\\rn\\ananta-pos && react-native start",
    "dev": "npx react-native run-android",
    "dev-new": "node scripts/android-subst.js -- --device ZD222H4WQ2 --no-packager --port 8081",
    "start-8081": "react-native start --port 8081",
    "apk": "cd android && gradlew assembleRelease && cd ..",
    "aab": "cd android && gradlew bundleRelease && cd ..",
    "stop": "taskkill /f /im java.exe 2>nul & taskkill /f /im node.exe 2>nul & timeout /t 2 /nobreak >nul",
    "cls": "node scripts/android-clean.js",
    "un": "adb -s ZD222H4WQ2 uninstall com.anantaa.swadeshpos",
    "dvs": "adb devices",
    "clear-cache": "npm cache clean --force && node scripts/android-clean.js && echo. && echo All caches cleared. Start Metro with: npm start -- --reset-cache",
    "env:clear-cache": "node scripts/clear-env-cache.js",
    "env:verify": "node scripts/verify-dotenv.js",
    "env:reset": "node scripts/clear-env-cache.js && node scripts/verify-dotenv.js",
    "cache": "npm cache clean --force"
  },
