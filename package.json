{
  "name": "AnantaRestroPosMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "start:reset": "react-native start --reset-cache",
    "start:short": "cd /d D:\\rn\\ananta-pos && react-native start",
    "dev": "node scripts/android-subst.js -- --device ZD222H4WQ2 --no-packager --port 8081",
    "start-8081": "react-native start --port 8081",
    "apk": "cd android && gradlew assembleRelease && cd ..",
    "aab": "cd android && gradlew bundleRelease && cd ..",
    "stop": "taskkill /f /im java.exe 2>nul & taskkill /f /im node.exe 2>nul & timeout /t 2 /nobreak >nul",
    "cls": "cd android && gradlew clean && cd ..",
    "un": "adb -s ZD222H4WQ2 uninstall com.anantarestroposmobile",
    "dvs": "adb devices",
    "clear-cache": "npm cache clean --force && yarn cache clean && cd android && gradlew clean && cd .. && echo. && echo All caches cleared. Start Metro with: npm start -- --reset-cache"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.2.1",
    "@react-navigation/native-stack": "^7.14.9",
    "@react-navigation/stack": "^7.8.8",
    "@reduxjs/toolkit": "^2.11.2",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.5",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
